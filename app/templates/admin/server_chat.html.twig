{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Chat — {{ server.name }}{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-body">
            <h5 class="card-title d-flex justify-content-between align-items-center">
                <span>{{ server.name }} <small class="text-muted">({{ server.login }})</small></span>
                <span class="badge bg-secondary" id="chat-count">{{ messages|length }} message(s)</span>
            </h5>

            <div id="chat-messages"
                 style="height: 480px; overflow-y: auto; background: #1a1a1a; color: #e0e0e0; padding: 12px; border-radius: 4px; font-family: monospace; font-size: 13px; line-height: 1.5;">
                {% for m in messages %}
                    <div class="chat-line" data-id="{{ m.id }}">
                        <span style="color: #888;">[{{ m.createdAt|date('H:i:s') }}]</span>
                        {% if m.type.value == 'player' %}
                            <span style="color: #4fc3f7;">{{ m.playerPseudo ?? m.playerLogin ?? '?' }}:</span>
                            <span>{{ m.content }}</span>
                        {% elseif m.type.value == 'server' %}
                            <span style="color: #ffb74d;">[SERVER]</span>
                            <span>{{ m.content }}</span>
                        {% else %}
                            <span style="color: #aed581;">[SYSTEM]</span>
                            <span>{{ m.content }}</span>
                        {% endif %}
                    </div>
                {% else %}
                    <div class="text-muted">Aucun message pour le moment.</div>
                {% endfor %}
            </div>

            <form id="chat-send-form" class="mt-3">
                <div class="input-group">
                    <input id="chat-send-input" type="text" name="message" class="form-control" placeholder="Envoyer un message en tant que serveur…" maxlength="500" required autofocus>
                    <button id="chat-send-btn" type="submit" class="btn btn-primary"><i class="fa fa-paper-plane"></i> Envoyer</button>
                </div>
                <div id="chat-send-feedback" class="small mt-1" style="min-height: 1.2em;"></div>
            </form>
        </div>
    </div>

    <script>
        (function () {
            const url = {{ path('admin_server_chat_messages', {id: server.id})|json_encode|raw }};
            const sendUrl = {{ path('admin_server_chat_send', {id: server.id})|json_encode|raw }};
            const container = document.getElementById('chat-messages');
            const counter = document.getElementById('chat-count');
            const form = document.getElementById('chat-send-form');
            const input = document.getElementById('chat-send-input');
            const sendBtn = document.getElementById('chat-send-btn');
            const feedback = document.getElementById('chat-send-feedback');

            function escapeHtml(s) {
                return String(s ?? '').replace(/[&<>"']/g, c => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[c]));
            }

            function renderMessage(m) {
                const time = new Date(m.createdAt).toLocaleTimeString('fr-FR', {hour12: false});
                let body;
                if (m.type === 'player') {
                    const who = escapeHtml(m.pseudo || m.login || '?');
                    body = `<span style="color:#4fc3f7;">${who}:</span> <span>${escapeHtml(m.content)}</span>`;
                } else if (m.type === 'server') {
                    body = `<span style="color:#ffb74d;">[SERVER]</span> <span>${escapeHtml(m.content)}</span>`;
                } else {
                    body = `<span style="color:#aed581;">[SYSTEM]</span> <span>${escapeHtml(m.content)}</span>`;
                }
                return `<div class="chat-line" data-id="${m.id}"><span style="color:#888;">[${time}]</span> ${body}</div>`;
            }

            function isPinnedToBottom() {
                return container.scrollHeight - container.scrollTop - container.clientHeight < 40;
            }

            async function poll() {
                try {
                    const res = await fetch(url, {headers: {'Accept': 'application/json'}});
                    if (!res.ok) return;
                    const data = await res.json();
                    const messages = data.messages || [];
                    const wasAtBottom = isPinnedToBottom();
                    container.innerHTML = messages.length
                        ? messages.map(renderMessage).join('')
                        : '<div class="text-muted">Aucun message pour le moment.</div>';
                    counter.textContent = `${messages.length} message(s)`;
                    if (wasAtBottom) container.scrollTop = container.scrollHeight;
                } catch (e) {
                    // network glitch, retry next tick
                }
            }

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const message = input.value.trim();
                if (!message) return;
                sendBtn.disabled = true;
                feedback.textContent = '';
                feedback.className = 'small mt-1';
                try {
                    const res = await fetch(sendUrl, {
                        method: 'POST',
                        headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
                        body: JSON.stringify({message}),
                    });
                    const data = await res.json().catch(() => ({}));
                    if (res.ok && data.success) {
                        input.value = '';
                        feedback.textContent = '';
                        poll();
                    } else {
                        feedback.textContent = data.message || `Erreur HTTP ${res.status}`;
                        feedback.classList.add('text-danger');
                    }
                } catch (err) {
                    feedback.textContent = 'Erreur réseau : ' + err.message;
                    feedback.classList.add('text-danger');
                } finally {
                    sendBtn.disabled = false;
                    input.focus();
                }
            });

            // Scroll to bottom on initial load
            container.scrollTop = container.scrollHeight;
            setInterval(poll, 1000);
        })();
    </script>
{% endblock %}
