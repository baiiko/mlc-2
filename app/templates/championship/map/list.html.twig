{% extends 'base.html.twig' %}

{% block title %}{{ 'championship.maps'|trans({}, 'championship') }} - MLC{% endblock %}

{% block body %}
    <section class="max-w-[1400px] mx-auto px-10 py-12">
        <header class="mb-6">
            <h1 class="font-russo text-4xl mb-2">{{ 'championship.maps'|trans({}, 'championship') }}</h1>
            <p class="text-gray-light">{{ total }} circuit(s){% if search %} pour « {{ search }} »{% endif %}</p>
        </header>

        <form method="get" action="{{ path('app_championship_maps') }}" class="mb-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
            <input type="search" name="q" value="{{ search ?? '' }}" autocomplete="off"
                   placeholder="Nom du circuit…"
                   class="px-4 py-3 bg-bg-card border border-metal-dark rounded text-white placeholder-gray-mid focus:border-turquoise focus:outline-none">

            <input type="text" name="author" value="{{ author ?? '' }}" autocomplete="off"
                   placeholder="Auteur…"
                   class="px-4 py-3 bg-bg-card border border-metal-dark rounded text-white placeholder-gray-mid focus:border-turquoise focus:outline-none">

            <select name="season" class="px-4 py-3 bg-bg-card border border-metal-dark rounded text-white focus:border-turquoise focus:outline-none">
                <option value="">Toutes les saisons</option>
                {% for s in seasons %}
                    <option value="{{ s.id }}" {{ seasonId == s.id ? 'selected' : '' }}>{{ s.name }}</option>
                {% endfor %}
            </select>

            <div class="flex gap-2">
                <select name="round" class="flex-1 min-w-0 px-4 py-3 bg-bg-card border border-metal-dark rounded text-white focus:border-turquoise focus:outline-none">
                    <option value="">Toutes les manches</option>
                    {% for r in rounds %}
                        <option value="{{ r.id }}" {{ roundId == r.id ? 'selected' : '' }}>
                            {% if r.season %}{{ r.season.name }} · {% endif %}M{{ r.number }}{% if r.name %} · {{ r.name }}{% endif %}
                        </option>
                    {% endfor %}
                </select>
                <button type="submit" class="inline-flex items-center gap-2 px-4 py-3 bg-orange/20 text-orange border border-orange rounded hover:bg-orange/30 transition-colors font-semibold text-sm uppercase tracking-wider">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4h18M6 12h12M10 20h4"/>
                    </svg>
                    <span>Filtrer</span>
                </button>
            </div>
        </form>

        {% set hasFilters = search or author or seasonId or roundId %}
        {% if maps is empty %}
            <div class="bg-bg-card rounded-lg p-8 border border-metal-dark text-center">
                <p class="text-gray-mid">
                    {% if hasFilters %}Aucun circuit ne correspond à vos filtres.{% else %}{{ 'championship.no_maps'|trans({}, 'championship') }}{% endif %}
                </p>
            </div>
        {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for map in maps %}
                    {% include 'components/_map_card.html.twig' with {map: map, mapRecords: mapRecords, showRound: true} %}
                {% endfor %}
            </div>

            {% if totalPages > 1 %}
                <nav class="mt-8 flex items-center justify-center gap-2 flex-wrap" aria-label="Pagination">
                    {% set baseParams = {} %}
                    {% if search %}{% set baseParams = baseParams|merge({q: search}) %}{% endif %}
                    {% if author %}{% set baseParams = baseParams|merge({author: author}) %}{% endif %}
                    {% if seasonId %}{% set baseParams = baseParams|merge({season: seasonId}) %}{% endif %}
                    {% if roundId %}{% set baseParams = baseParams|merge({round: roundId}) %}{% endif %}
                    {% if page > 1 %}
                        <a href="{{ path('app_championship_maps', baseParams|merge({page: page - 1})) }}"
                           class="px-3 py-2 bg-bg-card border border-metal-dark rounded text-gray-light hover:text-turquoise hover:border-turquoise/50">‹</a>
                    {% endif %}

                    {% set windowStart = max(1, page - 2) %}
                    {% set windowEnd = min(totalPages, page + 2) %}
                    {% if windowStart > 1 %}
                        <a href="{{ path('app_championship_maps', baseParams|merge({page: 1})) }}" class="px-3 py-2 bg-bg-card border border-metal-dark rounded text-gray-light hover:text-turquoise hover:border-turquoise/50">1</a>
                        {% if windowStart > 2 %}<span class="text-gray-mid">…</span>{% endif %}
                    {% endif %}

                    {% for p in windowStart..windowEnd %}
                        <a href="{{ path('app_championship_maps', baseParams|merge({page: p})) }}"
                           class="px-3 py-2 border rounded {{ p == page ? 'bg-orange/20 border-orange text-white' : 'bg-bg-card border-metal-dark text-gray-light hover:text-turquoise hover:border-turquoise/50' }}">{{ p }}</a>
                    {% endfor %}

                    {% if windowEnd < totalPages %}
                        {% if windowEnd < totalPages - 1 %}<span class="text-gray-mid">…</span>{% endif %}
                        <a href="{{ path('app_championship_maps', baseParams|merge({page: totalPages})) }}" class="px-3 py-2 bg-bg-card border border-metal-dark rounded text-gray-light hover:text-turquoise hover:border-turquoise/50">{{ totalPages }}</a>
                    {% endif %}

                    {% if page < totalPages %}
                        <a href="{{ path('app_championship_maps', baseParams|merge({page: page + 1})) }}"
                           class="px-3 py-2 bg-bg-card border border-metal-dark rounded text-gray-light hover:text-turquoise hover:border-turquoise/50">›</a>
                    {% endif %}
                </nav>
            {% endif %}
        {% endif %}
    </section>
{% endblock %}
